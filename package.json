{
  "name": "mivo-model-viewer-monorepo",
  "private": true,
  "version": "0.9.0",
  "description": "Monorepo: browser 3D viewer SDK (mivo-model-viewer) + pure Node model tooling (mivo-model-node).",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace mivo-model-viewer",
    "typecheck": "npm run typecheck --workspace mivo-model-viewer",
    "build": "npm run build --workspace mivo-model-viewer",
    "build:lib": "npm run build:lib --workspace mivo-model-viewer",
    "build:demo": "npm run build:demo --workspace mivo-model-viewer",
    "build:pages": "npm run build:pages --workspace mivo-model-viewer",
    "preview": "npm run preview --workspace mivo-model-viewer",
    "test:node": "node --test test/node-*.test.mjs test/core-*.test.mjs",
    "cli": "node packages/node/cli.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xindong/modelviewer.git"
  }
}
