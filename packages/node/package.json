{
  "name": "mivo-model-node",
  "version": "0.9.0",
  "description": "Pure Node model processing: inspect, render, convert, optimize. CLI + backend API, no browser.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "gltf",
    "glb",
    "fbx",
    "obj",
    "step",
    "cli",
    "3d",
    "model",
    "convert",
    "optimize",
    "render"
  ],
  "files": [
    "**/*.mjs",
    "**/*.d.ts",
    "core",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_FBX2GLTF_LICENSE.txt"
  ],
  "bin": {
    "mivo-model-node": "./cli.mjs"
  },
  "imports": {
    "#core": "./core/index.ts",
    "#core/*": "./core/*.ts"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "cli": "node cli.mjs",
    "prepack": "node scripts/core-link.mjs materialize",
    "postpack": "node scripts/core-link.mjs link"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "commander": "15.0.0",
    "draco3dgltf": "1.5.7",
    "fflate": "^0.8.3",
    "linkedom": "0.18.13",
    "meshoptimizer": "1.2.0",
    "sharp": "0.35.5",
    "three": "^0.170.0"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "1.0.10",
    "fbx2gltf": "0.9.7-p1",
    "occt-import-js": "0.0.23",
    "webgpu": "0.6.2"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xindong/modelviewer.git"
  }
}
